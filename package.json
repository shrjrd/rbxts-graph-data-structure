{
	"name": "@rbxts/graph-data-structure",
	"version": "4.5.0",
	"description": "A graph data structure with topological sort.",
	"author": "Curran Kelleher",
	"contributors": [
		{
			"name": "Jonathan MASSUCHETTI",
			"email": "jonathan.massuchetti@dappit.fr",
			"url": "https://github.com/JesusTheHun"
		}
	],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/shrjrd/rbxts-graph-data-structure/issues"
	},
	"homepage": "https://github.com/shrjrd/rbxts-graph-data-structure#readme",
	"type": "module",
	"source": "src/index.ts",
	"main": "out/init.lua",
	"types": "out/index.d.ts",
	"scripts": {
		"prepack": "npm run build",
		"build": "rbxtsc",
		"compile:rbxl": "rbxtsc --type game --rojo default.project.json",
		"build:rbxl": "rojo sourcemap -o sourcemap.json && rojo build -o place.rbxl",
		"watch:rbxl": "npx concurrently \"npm run compile:rbxl -- -w\" \"rojo serve\""
	},
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/jest": "^3.13.3-alpha.2",
		"@rbxts/jest-globals": "^3.13.3-alpha.2",
		"@rbxts/types": "^1.0.894",
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.48.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-roblox-ts": "^1.3.0",
		"prettier": "^3.7.0",
		"roblox-ts": "^3.0.0",
		"rojo": "^1.0.3-rojo7.6.1",
		"typescript": "^5.9.3"
	},
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"!*.spec.*",
		"!jest.*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shrjrd/rbxts-graph-data-structure.git"
	},
	"keywords": [
		"graph",
		"data",
		"structures",
		"algorithms"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@rbxts/luau-polyfill": "^1.1.3"
	}
}
